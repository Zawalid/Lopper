{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lopper",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "lopper.zawalid.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/media/*.mp4"]
  }
}
