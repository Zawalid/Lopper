# Cloudflare Pages response headers.
# no-transform keeps Cloudflare from injecting its Web Analytics script into the pages (it is enabled for the whole
# zawalid.com zone, for Rimline). This site has no analytics.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/index.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/404.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/guides/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# /_astro files are content-hashed, so they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Media and fonts keep stable file names, so use a shorter lifetime and let ETag revalidate.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/fonts/*
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=86400
