---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  dark: ImageMetadata;
  light: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
}
const { dark, light, alt, sizes = '(min-width: 960px) 560px, 92vw', widths = [640, 960, 1280], loading = 'lazy' } = Astro.props;

async function build(src: ImageMetadata) {
  const set = await Promise.all(widths.map((width) => getImage({ src, width, format: 'webp' })));
  return {
    srcset: set.map((image, i) => `${image.src} ${widths[i]}w`).join(', '),
    fallback: set[Math.floor(set.length / 2)],
  };
}
const [d, l] = await Promise.all([build(dark), build(light)]);
---
<picture class="shot">
  <source media="(prefers-color-scheme: dark)" srcset={d.srcset} {sizes} type="image/webp" />
  <img
    src={l.fallback.src}
    srcset={l.srcset}
    {sizes}
    alt={alt}
    width={light.width}
    height={light.height}
    {loading}
    decoding="async"
  />
</picture>

<style>
  .shot { display: block; }
  .shot img { width: 100%; height: auto; }
</style>
