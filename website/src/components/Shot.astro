---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  class?: string;
}
const { src, alt, sizes = '(max-width: 600px) 160vw, (min-width: 1408px) 1280px, 92vw', widths = [960, 1440, 1920, 2880], loading = 'lazy', class: className } = Astro.props;
const set = await Promise.all(widths.map((width) => getImage({ src, width, format: 'webp', quality: 92 })));
const srcset = set.map((image, i) => `${image.src} ${widths[i]}w`).join(', ');
const fallback = set[2] ?? set[set.length - 1];
---
<img
  class={className}
  src={fallback.src}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  width={src.width}
  height={src.height}
  loading={loading}
  decoding="async"
/>
