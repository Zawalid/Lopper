---
import Base from './Base.astro';
import Shot from '../components/Shot.astro';
import agentsShot from '../assets/shots/agents-dark.png';
import { site, links } from '../data/site';
import { guidePath, type Guide } from '../data/guides';

interface Props { guide: Guide; toc?: { id: string; label: string }[] }
const { guide, toc = [] } = Astro.props;
const url = new URL(guidePath(guide.slug), site.url).toString();
const image = '/og-guide.png';
const day = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const author = { '@type': 'Person', name: 'Walid Zakan', url: links.author };
const data = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: guide.title,
    description: guide.description,
    datePublished: guide.published,
    dateModified: guide.updated,
    inLanguage: 'en',
    author,
    publisher: author,
    mainEntityOfPage: url,
    image: new URL(image, site.url).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Lopper', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL(links.guides, site.url).toString() },
      { '@type': 'ListItem', position: 3, name: guide.title, item: url },
    ],
  },
];
---
<Base title={guide.metaTitle} description={guide.description} image={image} imageAlt="Lopper guides" type="article" home={false} structuredData={data}>
  <article class="guide">
    <header class="wrap guide-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a class="link" href="/">Lopper</a><span aria-hidden="true">/</span><a class="link" href={links.guides}>Guides</a>
      </nav>
      <h1 class="title guide-title">{guide.title}</h1>
      <p class="lead">{guide.description}</p>
      <p class="byline">
        By <a class="link" href={links.author}>Walid Zakan</a>. Updated <time datetime={guide.updated}>{day(guide.updated)}</time>.
        <slot name="checked" />
      </p>
    </header>

    <div class="wrap guide-grid">
      <div class="guide-body prose"><slot /></div>
      {toc.length > 0 && (
        <nav class="toc" aria-label="On this page">
          <p class="toc-h">On this page</p>
          <ol>{toc.map((item) => <li><a class="link" href={`#${item.id}`}>{item.label}</a></li>)}</ol>
        </nav>
      )}
    </div>

    <aside class="wrap guide-cta" aria-labelledby="cta-title">
      <div class="cta-box">
        <h2 id="cta-title">or let Lopper do the checking.</h2>
        <p>
          Lopper is a free, open source Mac app. For every branch and worktree it shows whether it is merged, whether it
          holds uncommitted or unpushed work, and the git evidence behind that verdict. It refuses to remove a worktree
          that holds work which exists only in its folder, and everything it removes can be restored for 30 days.
        </p>
        <div class="cta-actions">
          <a class="btn btn-mint" href={links.download}>Download for macOS</a>
          <a class="btn btn-line" href={links.safety}>How it stays safe</a>
        </div>
        <p class="cta-cmd"><code>brew install --cask zawalid/lopper/lopper</code></p>
        <Shot src={agentsShot} alt="The Lopper Agents page: a table of agent worktrees with their state, unmerged work, activity, age and size, and a button to reclaim the finished ones." class="cta-shot" />
      </div>
    </aside>
  </article>
</Base>

<style is:global>
  .guide { padding-top: calc(72px + clamp(32px, 6vw, 80px)); padding-bottom: clamp(72px, 10vw, 140px); }
  .guide-head { display: grid; gap: 22px; max-width: 52rem; margin-inline: 0; padding-bottom: clamp(32px, 5vw, 56px); }
  .crumbs { display: flex; gap: 10px; font: 500 0.9rem var(--font-mono); color: var(--faint); }
  .crumbs a { color: var(--muted); }
  .guide-title { font-size: clamp(2.2rem, 5vw, 4.2rem); max-width: 16em; }
  .byline { font-size: 1rem; color: var(--faint); line-height: 1.6; }
  .byline a { color: var(--muted); }

  .guide-grid { display: grid; gap: 48px; }
  @media (min-width: 1100px) { .guide-grid { grid-template-columns: minmax(0, 46rem) 15rem; justify-content: space-between; align-items: start; } }
  .guide-body { display: grid; gap: 22px; min-width: 0; }
  .toc { display: none; }
  @media (min-width: 1100px) { .toc { display: block; position: sticky; top: 104px; } }
  .toc-h { font: 500 0.85rem var(--font-mono); color: var(--faint); margin-bottom: 14px; }
  .toc ol { list-style: none; display: grid; gap: 10px; border-left: 1px solid var(--line-strong); padding-left: 16px; }
  .toc a { color: var(--muted); font-size: 0.98rem; line-height: 1.35; display: inline-block; }
  .toc a:hover { color: var(--text); }
  .prose { font-size: 1.15rem; line-height: 1.7; color: #d7dedb; }
  .prose h2 { margin-top: clamp(28px, 4vw, 48px); font-weight: 800; font-size: clamp(1.7rem, 3vw, 2.3rem); line-height: 1.1; letter-spacing: -0.025em; color: var(--text); }
  .prose h3 { margin-top: 12px; font-weight: 700; font-size: 1.3rem; color: var(--text); }
  .prose p { max-width: 42rem; }
  .prose ul, .prose ol { display: grid; gap: 8px; padding-left: 1.3em; max-width: 42rem; }
  .prose li::marker { color: var(--mint); }
  .prose code { padding: 0.12em 0.4em; border-radius: 6px; background: rgba(241, 244, 242, 0.08); color: var(--text); }
  .prose strong { color: var(--text); }
  .term { margin: 0; padding: 18px 20px; overflow-x: auto; white-space: pre-wrap; overflow-wrap: anywhere; border-radius: var(--radius-sm); background: #0f1614; border: 1px solid var(--line-strong); font: 400 0.95rem/1.65 var(--font-mono); color: #d7dedb; tab-size: 2; }
  .term code { padding: 0; background: none; color: inherit; font: inherit; }
  .term .p { color: var(--mint); user-select: none; }
  .term .e { color: #f0a29a; }
  .term .d { color: var(--faint); }
  .term-note { font-size: 0.95rem; color: var(--faint); margin-top: -10px; }
  .callout { padding: 18px 22px; border-radius: var(--radius-sm); border: 1px solid var(--line-strong); background: var(--ink-2); max-width: 42rem; }
  .callout p + p { margin-top: 10px; }

  .guide-cta { margin-top: clamp(56px, 8vw, 110px); }
  .cta-box { display: grid; gap: 22px; padding: clamp(26px, 4vw, 52px); border-radius: var(--radius); background: var(--mint); color: var(--mint-ink); }
  .cta-box h2 { font-weight: 900; font-size: clamp(2rem, 4.4vw, 3.6rem); line-height: 0.95; letter-spacing: -0.035em; text-transform: lowercase; }
  .cta-box p { max-width: 40rem; color: var(--mint-muted); }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .cta-box .btn-mint { --bg: var(--mint-ink); --fg: var(--mint); --bd: var(--mint-ink); }
  .cta-box .btn-line { --fg: var(--mint-ink); --bd: rgba(11, 16, 15, 0.4); }
  .cta-cmd code { background: rgba(11, 16, 15, 0.1); color: var(--mint-ink); padding: 0.3em 0.6em; border-radius: 8px; font-size: 0.95rem; }
  .cta-shot { border-radius: 12px; box-shadow: 0 24px 50px -20px rgba(11, 16, 15, 0.55); }
</style>
